<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Habitats - Into The Wild</title>
</head>
<body>
    <%- include('partials/header') %>
    <h1>Our Habitats</h1>
    <% habitats.forEach(habitat => { %>
        <div>
            <h2><%= habitat.name %></h2>
            <p><%= habitat.description %></p>
        </div>
    <% }) %>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Habitats - Into The Wild</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>
    <h1>Our Habitats</h1>
    <div class="habitats-grid">
        <% habitats.forEach(habitat => { %>
            <div class="habitat-card">
                <div style="padding: 15px;">
                    <h2><%= habitat.name %></h2>
                    <p><%= habitat.description %></p>
                </div>
                <% if (habitat.name === 'Savannah Plains') { %>
                    <img src="/images/Savannah/sv1.jpg" alt="Savannah Plains">
                <% } else if (habitat.name === 'Tropical Rainforest') { %>
                    <img src="/images/Rainforest/rf1.jpg" alt="Tropical Rainforest">
                <% } else if (habitat.name === 'Reptile World') { %>
                    <img src="/images/Reptile/cro1.jpg" alt="Reptile World">
                <% } %>               
            </div>
        <% }) %>
    </div>
    <%- include('partials/footer') %>
</body>
</html>
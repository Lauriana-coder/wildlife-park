<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Opening Times - Into The Wild</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>
    <h1>Opening Times</h1>

    <div class="opening-box">
        <h2>We are open every day!</h2>
        <p class="big-time">9:00 AM — 6:00 PM</p>
        <p>Including weekends and bank holidays.</p>

        <table class="times-table">
            <tr>
                <th>Day</th>
                <th>Opening</th>
                <th>Closing</th>
            </tr>
            <tr>
                <td>Monday</td>
                <td>9:00 AM</td>
                <td>6:00 PM</td>
            </tr>
            <tr>
                <td>Tuesday</td>
                <td>9:00 AM</td>
                <td>6:00 PM</td>
            </tr>
            <tr>
                <td>Wednesday</td>
                <td>9:00 AM</td>
                <td>6:00 PM</td>
            </tr>
            <tr>
                <td>Thursday</td>
                <td>9:00 AM</td>
                <td>6:00 PM</td>
            </tr>
            <tr>
                <td>Friday</td>
                <td>9:00 AM</td>
                <td>6:00 PM</td>
            </tr>
            <tr>
                <td>Saturday</td>
                <td>9:00 AM</td>
                <td>6:00 PM</td>
            </tr>
            <tr>
                <td>Sunday</td>
                <td>9:00 AM</td>
                <td>6:00 PM</td>
            </tr>
        </table>
    </div>
    <%- include('partials/footer') %>       
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Animal Quiz - Into The Wild</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>
    <div style="display:flex; justify-content:center; padding-top:40px;">
        <div id="quiz"> 
            <h1>Animal Quiz</h1>
            <p style="text-align: center; margin-bottom: 20px;">Test your wildlife knowledge!</p>
            <div id="question-box">
                <h2 id="question">Loading...</h2>
                <div id="options"></div>
                <p id="feedback" style="margin-top:15px; font-weight:bold;"></p>
                <button id="next-btn" style="display:none; margin-top:15px;">Next Question</button>
            </div>
            <div id="result" style="display:none;">
                <h2>Quiz Complete!</h2>
                <p id="score"></p>
                <button id="restart-btn">Play Again</button>
            </div>
        </div>
    </div>
    <script src="/js/quiz.js"></script>
    <%- include('partials/footer') %>
</body>
</html>
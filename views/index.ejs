<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Into The Wild</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <!-- Hero section with background image -->
    <div class="hero" role="img" aria-label="Sunlight rays piercing through the tall trees and hanging vines of a dense tropical rainforest viewed from below">
        <div class="hero-text">
            <h1>Welcome to Into The Wild</h1>
            <p>Open every day 9:00 AM — 6:00 PM</p>
        </div>
    </div>

    <!-- Slideshow section -->
    <div class="slideshow-container">
        <img id="slideshow-img" src="/images/slideshow/sl1.jpg" alt="A small brown bird perched on a moss-covered rock with a blurred natural background">
    </div>

    <%- include('partials/footer') %>
    <script src="/js/slideshow.js"></script>
</body>
</html> 
